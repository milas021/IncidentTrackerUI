@page "/teams"
@using IncidentTrackerUI.Models.Teams
@using IncidentTrackerUI.Models.Users

<PageTitle>Teams</PageTitle>

<h1>Teams</h1>

<div class="d-flex justify-content-end mb-3">
    <button class="btn btn-primary" @onclick="OpenCreateModal">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
        </svg>
        Add Team
    </button>
</div>

@if (loadError is not null)
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">
        <span>@loadError</span>
        <button class="btn btn-sm btn-outline-danger" @onclick="LoadTeamsAsync">Retry</button>
    </div>
}

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2">
        <div class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></div>
        <span>Loading teams...</span>
    </div>
}
else if (loadError is null)
{
    @if (teams.Count == 0)
    {
        <div class="alert alert-secondary" role="alert">No teams found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Members</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var team in teams)
                    {
                        <tr>
                            <td>@team.Name</td>
                            <td>@(string.IsNullOrWhiteSpace(team.Description) ? "—" : team.Description)</td>
                            <td>@team.Users.Count</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenMembersModal(team)">
                                    Members
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@* ---- Add team modal ---- *@

@if (isCreateModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <EditForm Model="createModel" OnValidSubmit="CreateTeamAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">Add team</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseCreateModal" disabled="@isCreating"></button>
                    </div>
                    <div class="modal-body">
                        <ValidationSummary class="text-danger" />
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="createModel.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="createModel.Description" />
                        </div>
                        @if (modalError is not null)
                        {
                            <div class="alert alert-danger py-2 mb-0">@modalError</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseCreateModal" disabled="@isCreating">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@isCreating">
                            @if (isCreating)
                            {
                                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                            }
                            Add
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@* ---- Members modal: pick users to assign to the team ---- *@

@if (teamForMembers is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Members — @teamForMembers.Name</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseMembersModal" disabled="@isSavingMembers"></button>
                </div>
                <div class="modal-body">
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button" @onclick="ToggleMemberDropdown">
                            @selectedMemberIds.Count selected
                        </button>
                        @if (isMemberDropdownOpen)
                        {
                            <ul class="dropdown-menu show w-100" style="max-height: 260px; overflow-y: auto;">
                                @if (allUsers.Count == 0)
                                {
                                    <li><span class="dropdown-item-text text-muted">No users available.</span></li>
                                }
                                @foreach (var user in allUsers)
                                {
                                    <li>
                                        <label class="dropdown-item d-flex align-items-center gap-2 mb-0">
                                            <input type="checkbox"
                                                   checked="@selectedMemberIds.Contains(user.Id)"
                                                   @onchange="e => ToggleMember(user.Id, e)" />
                                            <span>@user.FullName <small class="text-muted">@user.Email</small></span>
                                        </label>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    @if (selectedMemberIds.Count > 0)
                    {
                        <div class="mt-3 d-flex flex-wrap gap-1">
                            @foreach (var user in allUsers.Where(u => selectedMemberIds.Contains(u.Id)))
                            {
                                <span class="badge bg-primary text-white">@user.FullName</span>
                            }
                        </div>
                    }

                    @if (modalError is not null)
                    {
                        <div class="alert alert-danger py-2 mb-0 mt-3">@modalError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseMembersModal" disabled="@isSavingMembers">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="ConfirmMembersAsync" disabled="@isSavingMembers">
                        @if (isSavingMembers)
                        {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                        }
                        Confirm
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@inject IServiceProvider ServiceProvider

@code {
    private HttpClient Api = default!;

    private List<TeamDto> teams = new();
    private List<UserDto> allUsers = new();
    private bool isLoading = true;
    private string? loadError;
    private string? modalError;

    // Create
    private bool isCreateModalOpen;
    private AddTeamCommand createModel = new();
    private bool isCreating;

    // Members
    private TeamDto? teamForMembers;
    private HashSet<Guid> selectedMemberIds = new();
    private bool isMemberDropdownOpen;
    private bool isSavingMembers;

    protected override async Task OnInitializedAsync()
    {
        Api = ServiceProvider.GetRequiredKeyedService<HttpClient>("Api");
        await LoadTeamsAsync();
        await LoadUsersAsync();
    }

    private async Task LoadTeamsAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            teams = await Api.GetFromJsonAsync<List<TeamDto>>("api/Team", ApiJson.Options) ?? new();
        }
        catch (Exception ex)
        {
            loadError = $"Failed to load teams: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            allUsers = await Api.GetFromJsonAsync<List<UserDto>>("api/Users", ApiJson.Options) ?? new();
        }
        catch
        {
            // The user list only feeds the members dropdown; a failure here shouldn't block the table.
            allUsers = new();
        }
    }

    // ---- Create ----

    private void OpenCreateModal()
    {
        isCreateModalOpen = true;
        createModel = new AddTeamCommand();
        modalError = null;
    }

    private void CloseCreateModal()
    {
        isCreateModalOpen = false;
        modalError = null;
    }

    private async Task CreateTeamAsync()
    {
        isCreating = true;
        modalError = null;
        try
        {
            var response = await Api.PostAsJsonAsync("api/Team", createModel, ApiJson.Options);
            response.EnsureSuccessStatusCode();

            await LoadTeamsAsync();
            isCreateModalOpen = false;
        }
        catch (Exception ex)
        {
            modalError = $"Failed to create team: {ex.Message}";
        }
        finally
        {
            isCreating = false;
        }
    }

    // ---- Members ----

    private void OpenMembersModal(TeamDto team)
    {
        teamForMembers = team;
        selectedMemberIds = team.Users.Select(u => u.Id).ToHashSet();
        isMemberDropdownOpen = false;
        modalError = null;
    }

    private void CloseMembersModal()
    {
        teamForMembers = null;
        isMemberDropdownOpen = false;
        modalError = null;
    }

    private void ToggleMemberDropdown() => isMemberDropdownOpen = !isMemberDropdownOpen;

    private void ToggleMember(Guid userId, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            selectedMemberIds.Add(userId);
        }
        else
        {
            selectedMemberIds.Remove(userId);
        }
    }

    private async Task ConfirmMembersAsync()
    {
        if (teamForMembers is null)
        {
            return;
        }

        isSavingMembers = true;
        modalError = null;
        try
        {
            var command = new AddMemberToTeamCommand { MemberIds = selectedMemberIds.ToList() };
            var response = await Api.PostAsJsonAsync($"api/Team/{teamForMembers.Id}", command, ApiJson.Options);
            response.EnsureSuccessStatusCode();

            await LoadTeamsAsync();
            teamForMembers = null;
        }
        catch (Exception ex)
        {
            modalError = $"Failed to save members: {ex.Message}";
        }
        finally
        {
            isSavingMembers = false;
        }
    }
}
