@page "/users"
@using IncidentTrackerUI.Models.Users

<PageTitle>Users</PageTitle>

<h1>Users</h1>

<div class="d-flex justify-content-end mb-3">
    <button class="btn btn-primary" @onclick="OpenCreateModal">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
        </svg>
        Add User
    </button>
</div>

@if (loadError is not null)
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">
        <span>@loadError</span>
        <button class="btn btn-sm btn-outline-danger" @onclick="LoadUsersAsync">Retry</button>
    </div>
}

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2">
        <div class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></div>
        <span>Loading users...</span>
    </div>
}
else if (loadError is null)
{
    @if (users.Count == 0)
    {
        <div class="alert alert-secondary" role="alert">No users found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Mobile</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>
                            <td>@(string.IsNullOrWhiteSpace(user.Mobile) ? "—" : user.Mobile)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@* ---- Add user modal ---- *@

@if (isCreateModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <EditForm Model="createModel" OnValidSubmit="CreateUserAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">Add user</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseCreateModal" disabled="@isCreating"></button>
                    </div>
                    <div class="modal-body">
                        <ValidationSummary class="text-danger" />
                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <InputText class="form-control" @bind-Value="createModel.FullName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <InputText class="form-control" type="email" @bind-Value="createModel.Email" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mobile</label>
                            <InputText class="form-control" @bind-Value="createModel.Mobile" />
                        </div>
                        @if (modalError is not null)
                        {
                            <div class="alert alert-danger py-2 mb-0">@modalError</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseCreateModal" disabled="@isCreating">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@isCreating">
                            @if (isCreating)
                            {
                                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                            }
                            Add
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@inject IServiceProvider ServiceProvider

@code {
    private HttpClient Api = default!;

    private List<UserDto> users = new();
    private bool isLoading = true;
    private string? loadError;
    private string? modalError;

    private bool isCreateModalOpen;
    private CreateUserCommand createModel = new();
    private bool isCreating;

    protected override async Task OnInitializedAsync()
    {
        Api = ServiceProvider.GetRequiredKeyedService<HttpClient>("Api");
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            users = await Api.GetFromJsonAsync<List<UserDto>>("api/Users", ApiJson.Options) ?? new();
        }
        catch (Exception ex)
        {
            loadError = $"Failed to load users: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        isCreateModalOpen = true;
        createModel = new CreateUserCommand();
        modalError = null;
    }

    private void CloseCreateModal()
    {
        isCreateModalOpen = false;
        modalError = null;
    }

    private async Task CreateUserAsync()
    {
        isCreating = true;
        modalError = null;
        try
        {
            var response = await Api.PostAsJsonAsync("api/Users", createModel, ApiJson.Options);
            response.EnsureSuccessStatusCode();

            await LoadUsersAsync();
            isCreateModalOpen = false;
        }
        catch (Exception ex)
        {
            modalError = $"Failed to create user: {ex.Message}";
        }
        finally
        {
            isCreating = false;
        }
    }
}
