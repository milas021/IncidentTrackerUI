@page "/"

<PageTitle>Incident Tracker</PageTitle>

<div class="p-5 mb-4 bg-primary text-white rounded-3">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold">Incident Tracker</h1>
        <p class="col-md-9 fs-5">
            A central place to log, track and resolve operational incidents &mdash; from the assets and
            teams involved, to the work orders raised to fix them.
        </p>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Assets</h5>
                <p class="card-text">Keep an inventory of the equipment and resources that can be affected by an incident.</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Incidents</h5>
                <p class="card-text">Log, classify and follow up on incidents as they are reported and resolved.</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Work Orders</h5>
                <p class="card-text">Turn incidents into actionable work orders and track them through to completion.</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Teams</h5>
                <p class="card-text">Organize the teams responsible for handling incidents and work orders.</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Users</h5>
                <p class="card-text">Manage the people who use the system and their team assignments.</p>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">About the author</h5>
        <p class="card-text mb-1">Built and maintained by Milad Rasooli.</p>
        <p class="card-text">
            <a href="mailto:miladrasooli021@gmail.com">miladrasooli021@gmail.com</a>
        </p>
    </div>
</div>
